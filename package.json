{
  "name": "school-management-system",
  "productName": "School Management System",
  "version": "1.0.0",
  "description": "Offline-first desktop School Management System built with Electron, React, Vite and SQLite.",
  "main": "electron/main.js",
  "author": "School Management System",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 NODE_ENV=development electron .",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "smoke": "electron scripts/smoke-test.js",
    "test:security": "electron scripts/security-test.js",
    "test:phase2": "electron scripts/phase2-test.js",
    "test:ui": "electron scripts/ui-test.js",
    "test:phase3": "electron scripts/phase3-test.js",
    "test:phase4": "electron scripts/phase4-test.js",
    "test:phase5": "electron scripts/phase5-test.js",
    "test:phase6": "electron scripts/phase6-test.js",
    "test:phase7": "electron scripts/phase7-test.js",
    "test:phase8": "electron scripts/phase8-test.js",
    "test:phase9": "electron scripts/phase9-test.js",
    "test:classes": "electron scripts/classes-test.js",
    "test:features": "electron scripts/features-test.js",
    "test:ipc": "electron scripts/ipc-smoke-test.js",
    "check:routes": "node scripts/route-check.js",
    "check:i18n": "node scripts/i18n-check.cjs",
    "test:all": "powershell -ExecutionPolicy Bypass -File scripts/run-all-tests.ps1",
    "shots": "electron scripts/screenshots.js",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-sqlite3": "12.4.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "exceljs": "4.4.0",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "38.8.6",
    "electron-builder": "26.15.3",
    "electron-rebuild": "3.2.9",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "wait-on": "9.5.1"
  }
}